# Copy to .env (bun/vite auto-loads it locally). On Vercel, set these under
# Project Settings -> Environment Variables instead.
#
# Nothing below is required for local dev or a first deploy — every value
# has a working default. Fill these in as you move past the in-memory demo
# store (see src/server/singletons.ts) toward real data.

# ---------------------------------------------------------------------------
# Client-side (must be prefixed VITE_ to reach the browser bundle)
# ---------------------------------------------------------------------------

# Only set this if the dashboard should call a *different*, separately
# hosted backend instead of this project's own /v1/* API routes. Leave unset
# (or empty) for the normal same-origin setup — see src/routes/dashboard.tsx.
# VITE_HAZE_API_URL=

# ---------------------------------------------------------------------------
# Server-side (API routes under src/routes/v1/**, src/routes/health.ts)
# ---------------------------------------------------------------------------

# Persistence (src/server/db/client.ts, src/server/singletons.ts). Leave
# unset for local dev — ProfileStore/SplitterSimulator/ActivityLog fall
# back to in-memory storage automatically, same as before. On Vercel, this
# gets set FOR YOU when you attach a Postgres integration (Project ->
# Storage -> Create Database -> Postgres) — don't set it by hand there.
# Without it, wallet data does not reliably survive between requests in
# production; see singletons.ts's persistence comment for what that looks
# like when it goes wrong.
# POSTGRES_URL=

# How many synthetic demo wallets to seed per server instance on startup.
SEED_WALLET_COUNT=40

# Price per x402-gated buyer query, in USDC.
QUERY_PRICE_USDC=0.02

# CORS origin allowed on the buyer-facing endpoints (/health,
# /v1/profiles/query) — these are the only routes external AI agents hit
# directly from arbitrary origins. "*" is fine for early testing; set this
# to your known buyer origins (or leave "*" if buyers are arbitrary,
# unauthenticated HTTP clients, which is the x402 model described in the
# product brief) before relying on this in production.
CORS_ORIGIN=*

# Which Robinhood Chain network POST /v1/wallets/import indexes against.
# "testnet" (chain 46630) or "mainnet" (chain 4663). Defaults to testnet
# even if unset — see src/server/indexer/realIndexer.ts.
HAZE_NETWORK=testnet

# Optional overrides for the real indexer. Leave blank to use Robinhood
# Chain's public endpoints for HAZE_NETWORK above (rate-limited, fine for
# dev). Set these if you have a dedicated RPC/explorer provider
# (Chainstack, QuickNode, etc.) instead.
ROBINHOOD_RPC_URL=
ROBINHOOD_EXPLORER_API_URL=

# The address x402 payments settle to, and the deployed HazeSplitter
# contract's address once on-chain registry syncing is wired up (see
# src/server/registryBridge/syncWeights.ts — applySyncPlan() is not
# implemented yet).
HAZE_SPLITTER_ADDRESS=
HAZE_PROFILE_REGISTRY_ADDRESS=

# Not read anywhere yet. src/server/indexer/realIndexer.ts intentionally
# does NOT guess these — it needs the actual deployed addresses from a
# protocol-contracts repo before it can classify DeFi usage, equity/stock
# trades, or sector preferences. Until these are set, those fingerprint
# fields stay at honest neutral defaults and POST /v1/wallets/import
# reports exactly that in its `dataGaps` response field.
# HAZE_UNISWAP_ROUTER_ADDRESS=
# HAZE_MORPHO_ADDRESSES=
# HAZE_STOCK_REGISTRY_ADDRESS=
